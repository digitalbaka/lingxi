<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/formRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="登录凌汐"
            android:textColor="@color/lx_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="欢迎回来，老伙计"
            android:textColor="@color/lx_text_sub"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/auth_input_bg"
            android:hint="用户名"
            android:inputType="text"
            android:textColor="@color/lx_text"
            android:textColorHint="@color/lx_text_sub"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/auth_input_bg"
            android:hint="密码"
            android:inputType="textPassword"
            android:textColor="@color/lx_text"
            android:textColorHint="@color/lx_text_sub"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_green"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="登 录"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 两步验证区：默认隐藏，mfaRequired 时展开 -->
        <LinearLayout
            android:id="@+id/group2fa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="两步验证"
                android:textColor="@color/lx_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmailMasked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/lx_text_sub"
                android:textSize="13sp" />

            <!-- 图形验证码：发邮箱验证码前需要 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/auth_input_bg">

                    <com.lingxi.classic.util.SvgCaptchaView
                        android:id="@+id/webCaptcha"
                        android:layout_width="match_parent"
                        android:layout_height="48dp" />
                </FrameLayout>

                <EditText
                    android:id="@+id/etCaptcha"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/auth_input_bg"
                    android:hint="图形验证码"
                    android:inputType="text"
                    android:textColor="@color/lx_text"
                    android:textColorHint="@color/lx_text_sub"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="点击图片可刷新验证码"
                android:textColor="@color/lx_text_sub"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et2faCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/auth_input_bg"
                    android:hint="邮箱验证码"
                    android:inputType="number"
                    android:textColor="@color/lx_text"
                    android:textColorHint="@color/lx_text_sub"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnSendCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_button_green"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="发送验证码"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvUseRecovery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="无法接收邮件？使用恢复码"
                android:textColor="@color/lx_blue"
                android:textSize="13sp"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/cbRemember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="记住这台设备，下次登录免验证"
                android:textColor="@color/lx_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnConfirm2fa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_green"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="确认登录"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="注册新账号"
                android:textColor="@color/lx_green_dark"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  |  "
                android:textColor="@color/lx_divider"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvForgot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="忘记密码"
                android:textColor="@color/lx_text_sub"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
